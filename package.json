{
  "name": "hockey-standings",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@hockey/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=3",
    "db:install": "node scripts/pg-local.mjs install && node scripts/pg-local.mjs start && node scripts/pg-local.mjs bootstrap",
    "db:up": "node scripts/pg-local.mjs start",
    "db:down": "node scripts/pg-local.mjs stop",
    "db:status": "node scripts/pg-local.mjs status",
    "db:reset": "node scripts/pg-local.mjs reset",
    "db:generate": "pnpm --filter @hockey/db generate",
    "db:migrate": "pnpm --filter @hockey/db migrate",
    "collector": "pnpm --filter @hockey/collector start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.8",
    "turbo": "^2.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.3.5"
    }
  }
}
