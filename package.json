    "turbo": "^2.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.3.5"
    }
  }
