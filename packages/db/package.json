{
  "name": "@hockey/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env.local src/migrate-cli.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "migrations"
  ]
}
